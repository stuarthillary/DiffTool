<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DiffTool</RootNamespace>
    <PublishAot>true</PublishAot>
    <!-- Mono.Cecil only trips trim warnings in its symbol-reader loading; AssemblyInspector sets ReadSymbols = false. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiffTool.Core\DiffTool.Core.csproj" />
    <ProjectReference Include="..\DiffTool.Reports\DiffTool.Reports.csproj" />
  </ItemGroup>

</Project>
